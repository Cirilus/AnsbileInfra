services:
  remnanode:
    image: {{ remnawave_node_image }}
    container_name: remnanode
    hostname: remnanode
    network_mode: host
    restart: always
    cap_add:
      - NET_ADMIN
    ulimits:
      nofile:
        soft: 1048576
        hard: 1048576
    environment:
      NODE_PORT: "{{ remnawave_node_port }}"
      SECRET_KEY: {{ remnawave_node_secret | to_json }}
{% if remnawave_node_enable_logs | bool or remnawave_node_reality_nginx_enabled | bool %}
    volumes:
{% if remnawave_node_enable_logs | bool %}
      - "{{ remnawave_node_logs_dir }}:/var/log/remnanode"
{% endif %}
{% if remnawave_node_reality_nginx_enabled | bool %}
      - "/dev/shm:/dev/shm:rw"
{% endif %}
{% endif %}
